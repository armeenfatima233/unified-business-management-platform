# Configure these in the backend environment; never commit actual credentials.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=

# Account-specific Resend receiving address; copy it from Emails > Receiving.
# Resend provides a managed <id>.resend.app subdomain when receiving is enabled.
RESEND_RECEIVING_ADDRESS=

# Explicit recipient for the opt-in test email script.
RESEND_TEST_RECIPIENT=
RESEND_TEST_TO_EMAIL=
