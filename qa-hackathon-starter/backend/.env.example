# Copy to .env (never commit .env). Values below are examples only.
PORT=8080
# SQLite file; created automatically. Persists across restarts.
DB_PATH=./data/app.db
# Comma-separated frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Set to "true" behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# How often (ms) due acknowledgement windows are checked. 1000 lets a demo use windows of a few seconds.
WORKER_INTERVAL_MS=1000
