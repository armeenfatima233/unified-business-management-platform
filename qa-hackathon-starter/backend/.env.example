# Copy to .env (never commit .env). Values below are examples only.
PORT=8080
# SQLite file; created automatically. Persists across restarts.
DB_PATH=./data/app.db
# Comma-separated frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Set to "true" behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# How often (ms) due acknowledgement windows are checked. 1000 lets a demo use windows of a few seconds.
WORKER_INTERVAL_MS=1000
# Integrations module (Resend, Google, ...). Provider keys are entered per workspace in the app, never here.
# Public HTTPS address that providers call back (a tunnel such as ngrok/cloudflared, or the deployed host).
PUBLIC_BASE_URL=http://localhost:8080
# Where links in alerts and OAuth redirects send people (the frontend).
FRONTEND_URL=http://localhost:3000
# Optional 32-byte key (64 hex chars) that encrypts provider secrets at rest. If unset, a random key is created in data/secrets.key.
# SECRETS_KEY=
